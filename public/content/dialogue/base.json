[
  {
    "id": "after_chat_hungry",
    "kind": "after", "after": "chat", "priority": 5,
    "when": { "npc.needs.hunger.lt": 25 },
    "nodes": {
      "start": {
        "options": [
          { "label": "「我这还有一点，你先吃。」", "when": { "player.items.food.gte": 1 }, "why": "你身上没有吃的", "action": "talk:give:food" },
          { "label": "「去找管仓库的要。」", "when": { "leader.not": "none" }, "hide": true,
            "reply": [{ "when": { "npc.keyHolder": true }, "text": "……我就是管仓库的。仓库也快空了。" }, { "text": "要？{?npc.rel.trust.gt:50 ? 我去过了。人家说按规矩来。 | 你以为我没去过？}" }], "end": true },
          { "label": "「大家都一样饿。」", "reply": "……是啊。", "effects": [{ "op": "rel", "from": "npc", "to": "player", "affection": -1 }], "end": true },
          { "label": "（换个话题）", "end": true }
        ]
      }
    }
  },
  {
    "id": "after_chat_hostile",
    "kind": "after", "after": "chat", "priority": 4,
    "when": { "npc.opinion.lt": 0 },
    "nodes": {
      "start": {
        "options": [
          { "label": "「我哪里得罪你了？」", "next": "why" },
          { "label": "「随你怎么想。」", "reply": "（冷笑了一声）", "effects": [{ "op": "rel", "from": "npc", "to": "player", "resentment": 2 }], "end": true },
          { "label": "（不说话了）", "end": true }
        ]
      },
      "why": {
        "npc": [
          { "when": { "npc.grudge.exists": true }, "text": "你自己心里清楚。{npc.grudge}" },
          { "text": "……没什么。就是看你不顺眼。" }
        ],
        "options": [
          { "label": "「那件事是我不对。对不起。」", "when": { "npc.grudge.exists": true }, "hide": true,
            "check": { "skill": "persuade", "bonus": 20 },
            "effects": [{ "op": "rel", "from": "npc", "to": "player", "resentment": -8, "trust": 3 }],
            "reply": [{ "when": { "npc.rel.resentment.gt": 50 }, "text": "……说句对不起就完了？" }, { "text": "（看了你很久）……行吧。这事先翻篇。" }],
            "fail": { "reply": "道歉有什么用。", "effects": [{ "op": "rel", "from": "npc", "to": "player", "resentment": -2 }], "end": true } },
          { "label": "「我拿东西补偿你。」", "when": { "player.items.cigs.gte": 3 }, "why": "需要 3 支烟",
            "effects": [{ "op": "item", "who": "player", "item": "cigs", "qty": -3 }, { "op": "item", "who": "npc", "item": "cigs", "qty": 3 }, { "op": "rel", "from": "npc", "to": "player", "resentment": -10, "debt": 5 }],
            "reply": "（把烟收进口袋）……东西我收下了。话还是那句话。", "end": true },
          { "label": "「在这种地方，谁不是这样。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "resentment": 3, "respect": 2 }], "reply": "呵。", "end": true }
        ]
      }
    }
  },
  {
    "id": "after_chat_scared",
    "kind": "after", "after": "chat", "priority": 3,
    "when": { "npc.needs.stress.gt": 75 },
    "nodes": {
      "start": {
        "options": [
          { "label": "「想说说吗？」", "next": "talk" },
          { "label": "「别说丧气话。」", "effects": [{ "op": "need", "who": "npc", "need": "stress", "add": 3 }], "reply": "……你说得轻巧。", "end": true }
        ]
      },
      "talk": {
        "npc": [
          { "when": { "npc.grief.exists": true }, "text": "我老是想起……{npc.grief}我闭上眼睛就是那个样子。" },
          { "when": { "warPhase.gte": 3 }, "text": "外面说的已经是另一种话了。他们会一间一间屋子搜过来的，对吧？" },
          { "text": "晚上一有动静我就醒。我怕哪天醒过来，门已经被炸开了。" }
        ],
        "options": [
          { "label": "「我们会出去的。我保证。」", "effects": [{ "op": "need", "who": "npc", "need": "stress", "add": -10 }, { "op": "rel", "from": "npc", "to": "player", "trust": 4 }, { "op": "fact", "key": "story.promised_out", "add": 1 }], "reply": "……你保证。我记住了。", "end": true },
          { "label": "「我也怕。」", "effects": [{ "op": "need", "who": "npc", "need": "stress", "add": -6 }, { "op": "need", "who": "player", "need": "stress", "add": -3 }, { "op": "rel", "from": "npc", "to": "player", "affection": 5 }, { "op": "rel", "from": "player", "to": "npc", "affection": 3 }], "reply": "（笑了一下，眼睛是红的）……那就一起怕吧。", "end": true },
          { "label": "（什么也不说，陪{他|她|TA:npc}坐一会儿）", "effects": [{ "op": "need", "who": "npc", "need": "stress", "add": -5 }, { "op": "rel", "from": "npc", "to": "player", "trust": 2, "affection": 2 }], "reply": "……", "end": true }
        ]
      }
    }
  },
  {
    "id": "after_chat_partner",
    "kind": "after", "after": "chat", "priority": 6,
    "when": { "npc.partnerIsPlayer": true }, "chance": 0.7,
    "nodes": {
      "start": {
        "options": [
          { "label": "（握住{他|她|TA:npc}的手）", "effects": [{ "op": "rel", "from": "npc", "to": "player", "affection": 3 }, { "op": "need", "who": "npc", "need": "stress", "add": -5 }, { "op": "need", "who": "player", "need": "stress", "add": -5 }], "reply": "（手很凉，但握得很紧）", "end": true },
          { "label": "「今晚过来吧。」", "when": { "settings.adult": true }, "hide": true, "action": "talk:intim" },
          { "label": "「等出去了，你第一件事想做什么？」", "next": "after" }
        ]
      },
      "after": {
        "npc": [
          { "when": { "npc.goals.any": ["E_CROSS", "E_PASS"] }, "text": "过河。找个有热水的地方，洗一个钟头的澡。然后睡觉，睡到不想睡为止。" },
          { "when": { "npc.age.gte": 45 }, "text": "回家看看。房子要是还在……就在门口坐一会儿。" },
          { "text": "吃一顿热的。不是罐头，是锅里煮出来的。……和你一起。" }
        ],
        "options": [ { "label": "「好。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": 3 }], "end": true } ]
      }
    }
  },
  {
    "id": "after_ask_self",
    "kind": "after", "after": "ask:self", "chance": 0.8,
    "when": { "npc.rel.trust.gte": 30 },
    "nodes": {
      "start": {
        "options": [
          { "label": "「那你怎么会到这儿来？」", "next": "how" },
          { "label": "「嗯。」", "end": true }
        ]
      },
      "how": {
        "npc": [
          { "when": { "npc.origin": "deserter" }, "text": "跟所有人一样，往没有炮弹的地方跑。只不过我跑的方向，是军法不允许的方向。" },
          { "when": { "npc.origin": "cadre" }, "text": "疏散名单上本来有我。车开走的时候，我在楼上收拾文件。……文件，你说可笑不可笑。" },
          { "when": { "npc.origin": "nurse" }, "text": "医院挨了一发。我从地下室爬出来，满街都是人在跑，我就跟着跑。" },
          { "when": { "npc.origin": "priest" }, "text": "教堂的门被人踢开了。主没有拦着他们，我也没有。" },
          { "when": { "npc.origin": "foreigner" }, "text": "领事馆前天就关门了。牌子上写着「暂停办公」。暂停。" },
          { "text": "我也说不清。那天晚上警报响了，有人喊这边有地方，我就来了。" }
        ],
        "options": [
          { "label": "「你还有别的打算吗？」", "next": "plan" },
          { "label": "「能活下来就好。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "affection": 2 }], "end": true }
        ]
      },
      "plan": {
        "npc": [
          { "when": { "npc.goals.any": ["E_CROSS", "E_PASS"] }, "text": "（压低声音）过河。只要有办法过河，我什么都愿意做。" },
          { "when": { "npc.goals.any": ["P_LEADER"] }, "text": "这里得有人管。没人管，大家只会抢，抢完了一起死。" },
          { "when": { "npc.goals.any": ["W_HOARD", "W_MARKET"] }, "text": "打算？多攒点东西。仗总有打完的一天，打完了，手里有东西的人说话才算数。" },
          { "when": { "npc.goals.any": ["L_PARTNER"] }, "text": "……我不想一个人熬过这个冬天。" },
          { "text": "活过今天，再想明天。" }
        ],
        "options": [
          { "label": "「我们想的一样。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": 5, "affection": 2 }], "reply": "（看了你一眼）……那我们可以互相帮衬。", "end": true },
          { "label": "「小心点，别让别人听见。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": 3 }], "reply": "嗯。", "end": true }
        ]
      }
    }
  },
  {
    "id": "after_beg_no",
    "kind": "after", "after": "beg:no",
    "when": { "npc.items.food.gte": 1 },
    "nodes": {
      "start": {
        "options": [
          { "label": "「求你了，就一口。」", "check": { "skill": "persuade", "bonus": -10 },
            "effects": [{ "op": "item", "who": "npc", "item": "food", "qty": -1 }, { "op": "item", "who": "player", "item": "food", "qty": 1 }, { "op": "rel", "from": "npc", "to": "player", "respect": -3, "debt": -10 }],
            "reply": "（犹豫了很久，掰了一半给你）……就这一次。",
            "fail": { "reply": "我说了不行。", "effects": [{ "op": "rel", "from": "npc", "to": "player", "affection": -2 }], "end": true } },
          { "label": "「借我一份，明天还你。」", "check": { "chance": 0.5 },
            "effects": [{ "op": "item", "who": "npc", "item": "food", "qty": -1 }, { "op": "item", "who": "player", "item": "food", "qty": 1 }, { "op": "rel", "from": "npc", "to": "player", "debt": -15 }, { "op": "memory", "who": "npc", "about": "player", "kind": "loan", "weight": -5, "text": "{player.realName}欠我一份口粮。" }],
            "reply": "……明天。你说的。",
            "fail": { "reply": "上次借的人，第二天就死了。不借。" } },
          { "label": "「我拿烟跟你换。」", "when": { "player.items.cigs.gte": 2 }, "why": "需要 2 支烟", "action": "trade" },
          { "label": "「……算了。」", "end": true }
        ]
      }
    }
  },
  {
    "id": "after_intim_refused",
    "kind": "after", "after": "intim:refused",
    "nodes": {
      "start": {
        "options": [
          { "label": "「对不起，是我想多了。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "resentment": -2, "trust": 1 }], "reply": "……没事。别再提了。", "end": true },
          { "label": "「你会改主意的。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "fear": 6, "resentment": 6, "trust": -5 }], "reply": "（往后退了一步）……离我远点。", "end": true },
          { "label": "（转身走开）", "action": "leave" }
        ]
      }
    }
  },
  {
    "id": "after_comfort",
    "kind": "after", "after": "comfort", "chance": 0.7,
    "when": { "npc.grief.exists": true },
    "nodes": {
      "start": {
        "npc": "……我老是梦见同一件事。{npc.grief}",
        "options": [
          { "label": "「跟我说说{他|她|TA:npc}吧。」", "effects": [{ "op": "need", "who": "npc", "need": "stress", "add": -8 }, { "op": "rel", "from": "npc", "to": "player", "trust": 5, "affection": 4 }, { "op": "cure", "who": "npc", "cond": "grief" }], "reply": "（说了很久。说到后来，终于哭出了声）", "end": true },
          { "label": "「人死不能复生。往前看。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "affection": -2 }], "reply": "……你不懂。", "end": true }
        ]
      }
    }
  },

  {
    "id": "ask_origin",
    "kind": "ask", "once": true, "chance": 0.35,
    "when": { "npc.rel.trust.between": [20, 70] },
    "nodes": {
      "start": {
        "npc": "对了——你以前是干什么的？{?player.origin.eq:deserter ? 你那身衣服，看着不像镇上的人。 | }",
        "options": [
          { "label": "说实话：「{player.originText}。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": 5 }],
            "reply": [
              { "when": { "player.origin": "deserter", "npc.regime": "loyal" }, "text": "（脸色变了）……逃兵。你知道被抓住是什么下场吧。我就当没听见。" },
              { "when": { "player.origin": "cadre", "npc.regime": "rebel" }, "text": "哦。坐办公室的。（不再看你）" },
              { "text": "嗯。……谢谢你跟我说实话。" }
            ] },
          { "label": "编一个：「镇上的厂里干活。」", "check": { "skill": "persuade", "bonus": 10 }, "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": 1 }], "reply": "哦，哪个厂？……算了，都炸平了。",
            "fail": { "reply": "（盯着你看了一会儿）……你撒谎的时候，眼睛不眨。", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": -8 }] } },
          { "label": "「那不重要了。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": -2 }], "reply": "……也是。" }
        ]
      }
    }
  },
  {
    "id": "ask_leader",
    "kind": "ask", "cooldown": 96, "chance": 0.3,
    "when": { "leader": "npc", "npc.isLeader": false, "npc.rel.trust.gt": 35 },
    "nodes": {
      "start": {
        "npc": "（看了看四周，压低声音）你觉得{leaderP.realName}这人怎么样？",
        "options": [
          { "label": "「靠得住。」", "effects": [{ "op": "rel", "from": "npc", "to": "leader", "trust": 3 }], "reply": [{ "when": { "npc.regime": "rebel" }, "text": "……是吗。我再看看。" }, { "text": "嗯，我也这么想。" }] },
          { "label": "「我信不过{leaderP.realName}。」", "effects": [{ "op": "rel", "from": "npc", "to": "leader", "trust": -4 }, { "op": "rel", "from": "npc", "to": "player", "trust": 2 }, { "op": "fact", "key": "story.doubted_leader", "add": 1 }],
            "reply": [{ "when": { "npc.rel.trust.gt": 60 }, "text": "（点了点头）不止你一个人这么想。" }, { "text": "这话你跟我说说就算了。" }] },
          { "label": "「问这个干什么？」", "reply": "……没什么。随便问问。", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": -1 }] }
        ]
      }
    }
  },
  {
    "id": "ask_survive",
    "kind": "ask", "cooldown": 72, "chance": 0.3,
    "when": { "warPhase.gte": 2 },
    "nodes": {
      "start": {
        "npc": "你说……我们能活着出去吗？",
        "options": [
          { "label": "「能。」", "effects": [{ "op": "need", "who": "npc", "need": "stress", "add": -6 }, { "op": "rel", "from": "npc", "to": "player", "trust": 2 }], "reply": "（点了点头，像是要说服自己）" },
          { "label": "「活不活得成，看我们自己。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "respect": 4 }], "reply": "……嗯。" },
          { "label": "「不知道。」", "effects": [{ "op": "need", "who": "npc", "need": "stress", "add": 2 }], "reply": "……你倒是诚实。" }
        ]
      }
    }
  },
  {
    "id": "ask_rations",
    "kind": "ask", "cooldown": 48, "chance": 0.45,
    "when": { "player.isLeader": true, "npc.needs.hunger.lt": 45 },
    "nodes": {
      "start": {
        "npc": "什么时候给大家加口粮？一天{rules.rationSize}份，干活的人顶不住。",
        "options": [
          { "label": "「等物资多了就加。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": 1 }], "reply": "……多了是什么时候？" },
          { "label": "「大家都得勒紧裤腰带。我也一样。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "respect": 3, "resentment": 1 }], "reply": "（没说话）" },
          { "label": "「给你多分一份，别声张。」", "when": { "food.gte": 2 }, "why": "仓库里没多余的了",
            "effects": [{ "op": "item", "who": "storage", "item": "food", "qty": -1 }, { "op": "item", "who": "npc", "item": "food", "qty": 1 }, { "op": "rel", "from": "npc", "to": "player", "debt": 12, "respect": -2 }, { "op": "fact", "key": "story.favoritism", "add": 1 }, { "op": "tag", "who": "player", "tag": "庇护" }],
            "reply": "（把罐头塞进怀里）……我记着你的好。" }
        ]
      }
    }
  },
  {
    "id": "ask_cigarette",
    "kind": "ask", "cooldown": 24, "chance": 0.5,
    "when": { "npc.traits.any": ["烟瘾"], "npc.items.cigs.lt": 1, "player.items.cigs.gte": 1 },
    "nodes": {
      "start": {
        "npc": "（盯着你的口袋）……有烟吗？给一根。",
        "options": [
          { "label": "（递给{他|她|TA:npc}一根）", "effects": [{ "op": "item", "who": "player", "item": "cigs", "qty": -1 }, { "op": "item", "who": "npc", "item": "cigs", "qty": 1 }, { "op": "rel", "from": "npc", "to": "player", "affection": 4, "debt": 6 }, { "op": "need", "who": "npc", "need": "stress", "add": -6 }], "reply": "（深吸了一口）……你是好人。" },
          { "label": "「拿东西来换。」", "action": "trade" },
          { "label": "「没有。」", "check": { "skill": "persuade", "bonus": 20 }, "reply": "……哦。", "fail": { "reply": "我刚才看见你抽了。（脸色难看起来）", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": -4 }] } }
        ]
      }
    }
  },
  {
    "id": "ask_family",
    "kind": "ask", "once": true, "chance": 0.25,
    "when": { "npc.rel.trust.gt": 55, "night": true },
    "nodes": {
      "start": {
        "npc": "你在外面……还有家人吗？",
        "options": [
          { "label": "「有。不知道他们还活着没有。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "affection": 4 }], "next": "share" },
          { "label": "「没有了。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "affection": 3 }], "reply": "……对不起，我不该问。" },
          { "label": "「我不想谈这个。」", "reply": "嗯。" }
        ]
      },
      "share": {
        "npc": [
          { "when": { "npc.age.gte": 45 }, "text": "我有个女儿，在省城读书。打仗前一个礼拜还来过信，说宿舍的暖气坏了。……我到现在还想着那个暖气。" },
          { "when": { "npc.origin": "foreigner" }, "text": "我妈妈在河对岸。隔着一条河，三公里。三公里。" },
          { "text": "我弟弟去年被征走了。他走的时候，鞋还是我缝的。" }
        ],
        "options": [ { "label": "「会再见到的。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": 3 }], "reply": "（没说话，只是点了点头）" } ]
      }
    }
  },
  {
    "id": "ask_warm",
    "kind": "ask", "cooldown": 48, "chance": 0.35,
    "when": { "settings.adult": true, "npc.rel.desire.gt": 55, "night": true, "npc.partnerIsPlayer": false },
    "nodes": {
      "start": {
        "npc": "（把毯子往身上拉了拉）……你冷不冷？",
        "options": [
          { "label": "「冷。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "desire": 5, "affection": 2 }, { "op": "rel", "from": "player", "to": "npc", "desire": 3 }], "reply": "……我也是。", "next": "closer" },
          { "label": "「还好。」", "reply": "哦。" }
        ]
      },
      "closer": {
        "options": [
          { "label": "（坐近一点）", "effects": [{ "op": "rel", "from": "npc", "to": "player", "desire": 4, "trust": 2 }, { "op": "need", "who": "player", "need": "warmth", "add": 5 }], "reply": "（没有躲开）" },
