          { "label": "「太冒险了。」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "respect": -1 }], "reply": "那你说怎么办？等着？" },
          { "label": "「有什么我能帮上的？」", "effects": [{ "op": "rel", "from": "npc", "to": "player", "trust": 3, "affection": 2 }], "reply": [{ "when": { "npc.goals.any": ["E_CROSS", "E_PASS"] }, "text": "打听打听，谁知道过河的门路。" }, { "when": { "npc.goals.any": ["S_SELF", "S_REBUILD"] }, "text": "找种子。还有零件，电台的零件。" }, { "text": "活着就行。" }] }
        ]
      }
    }
