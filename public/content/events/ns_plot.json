[
  {
    "id": "ns_ana_river",
    "title": "对岸的人",
    "trigger": {
      "on": "hourly",
      "hours": [
        20,
        23
      ],
      "chance": 0.1,
      "once": true,
      "minDay": 5
    },
    "cast": {
      "a": {
        "who": "ana",
        "when": {
          "rel.trust.gte": 50
        }
      }
    },
    "speaker": "a",
    "art": "dark",
    "text": "阿娜把你拉到通风井边上，确认四下没人，才压低声音开口。\n\n「河对岸有个人，大家叫他老鹰。冬天河面冻实了，他每个月走两趟，带烟和药过来，带人过去。」她顿了顿，「过去的人，要付钱。很多钱。」",
    "choices": [
      {
        "label": "「带上我。我们一起走。」",
        "effects": [
          {
            "op": "know",
            "who": "player",
            "fact": "K_SMUG"
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 8,
            "affection": 5
          },
          {
            "op": "fact",
            "key": "story.ana_cross_together",
            "value": true
          },
          {
            "op": "memory",
            "who": "a",
            "about": "player",
            "kind": "story",
            "weight": 25,
            "text": "{player.name}说要跟我一起过河。"
          }
        ],
        "result": "她看了你很久，伸出小拇指。「我们那边是这样说定的。」你勾住了它。"
      },
      {
        "label": "「你为什么告诉我？」",
        "effects": [
          {
            "op": "know",
            "who": "player",
            "fact": "K_SMUG"
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 3
          }
        ],
        "result": "「因为一个人过河，冻死了没人知道。」她笑了一下，「两个人，至少还有一个能回来讲故事。」"
      },
      {
        "label": "「这种事，应该让领导知道。」",
        "when": {
          "leader": "npc"
        },
        "hide": true,
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": -20,
            "resentment": 15,
            "affection": -8
          },
          {
            "op": "memory",
            "who": "a",
            "about": "player",
            "kind": "story",
            "weight": -40,
            "text": "我信错了人。{player.name}想把老鹰的事告诉领导。"
          }
        ],
        "result": "阿娜的脸一下子冷了。「你说吧。」她转身就走，「我会说是你编的。看看他们信谁。」"
      },
      {
        "label": "「太危险了。冰面会裂的。」",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "affection": 2
          },
          {
            "op": "know",
            "who": "player",
            "fact": "K_SMUG"
          }
        ],
        "result": "「留在这儿就不危险吗？」她摇摇头，「等占领军来了，像我这样口音的人，第一批就会被拉出去。」"
      }
    ]
  },
  {
    "id": "ns_marina_film",
    "title": "胶卷",
    "trigger": {
      "on": "hourly",
      "hours": [
        13,
        20
      ],
      "chance": 0.1,
      "once": true,
      "minDay": 4
    },
    "cast": {
      "a": {
        "who": "marina",
        "when": {
          "rel.trust.gte": 45
        }
      }
    },
    "speaker": "a",
    "text": "玛丽娜把你叫到一边，从大衣袖子的夹层里抽出三个小铁盒。\n\n「火车站广场，十一月九号。」她的声音很平，「他们说那些人是暴徒。这里面是他们的脸。如果有人搜到它，我会死。如果它出不去，他们就白死了。」",
    "choices": [
      {
        "label": "「藏进通风井。那里没人会去翻。」",
        "effects": [
          {
            "op": "fact",
            "key": "story.film_hidden",
            "value": "vent"
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 10,
            "affection": 5
          },
          {
            "op": "memory",
            "who": "a",
            "about": "player",
            "kind": "story",
            "weight": 30,
            "text": "{player.name}帮我藏了胶卷。"
          }
        ],
        "result": "你们趁着换班，把铁盒塞进通风井的缝里，用碎砖堵上。玛丽娜在砖上划了一个很小的记号。"
      },
      {
        "label": "「交给军方，说不定能换一张通行证。」",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": -12,
            "resentment": 10
          },
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": 8
          }
        ],
        "result": "「你知道开枪的是谁吗？」她把铁盒收了回去，「是军方。」"
      },
      {
        "label": "「你自己藏好。别把我卷进去。」",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": -4
          }
        ],
        "result": "她点点头，像是早就料到了。「对。这才是聪明人的回答。」"
      }
    ]
  },
  {
    "id": "ns_jiang_broadcast",
    "title": "通缉",
    "trigger": {
      "on": "hourly",
      "hours": [
        18,
        22
      ],
      "chance": 0.12,
      "once": true,
      "minDay": 3,
      "when": {
        "power": true
      }
    },
    "cast": {
      "a": {
        "who": "jiang"
      },
      "b": {
        "who": "zhou",
        "optional": true
      }
    },
    "speaker": "a",
    "text": "收音机里，播音员用一成不变的腔调念着名单：「……省师范学院，反革命煽动分子，以下人员务必于三日内向当地内务处报到……」\n\n蒋小舟手里的罐头掉在地上，滚到了桌子底下。没有人去捡。",
    "lines": [
      {
        "who": "b",
        "text": "反动学生。抓一个，少一个。"
      }
    ],
    "choices": [
      {
        "label": "关掉收音机",
        "effects": [
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": -5
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 4
          }
        ],
        "result": "屋里一下子安静了。蒋小舟弯腰把罐头捡起来，擦了擦，手一直在抖。"
      },
      {
        "label": "「他们找不到这儿的。」（对他说）",
        "effects": [
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": -8
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 6,
            "affection": 3
          },
          {
            "op": "memory",
            "who": "a",
            "about": "player",
            "kind": "story",
            "weight": 20,
            "text": "广播念名单那天，{player.name}站在我这边。"
          },
          {
            "op": "event",
            "id": "ns_jiang_night",
            "delay": 300
          }
        ],
        "result": "「你不知道他们，」他小声说，「他们什么都找得到。」可他没有再发抖。"
      },
      {
        "label": "「名单上有你吗？」（当着大家的面）",
        "effects": [
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": 15
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "fear": 10,
            "trust": -8
          },
          {
            "op": "rel",
            "from": "all",
            "to": "a",
            "trust": -4
          }
        ],
        "result": "所有人都看着他。蒋小舟张了张嘴，什么也没说出来。那天晚上，有人把铺位挪得离他远了一点。"
      }
    ]
  },
  {
    "id": "ns_he_cellar",
    "title": "地窖",
    "trigger": {
      "on": "hourly",
      "hours": [
        6,
        9
      ],
      "chance": 0.1,
      "once": true,
      "minDay": 6,
      "when": {
        "warPhase.gte": 2
      }
    },
    "cast": {
      "a": {
        "who": "he",
        "when": {
          "rel.trust.gte": 50
        }
      }
    },
    "speaker": "a",
    "text": "何神父在炉子边祷告完，把你叫到身边。\n\n「教堂的地窖里，有一条旧排水道，」他低声说，「四十年前修的，那时候还允许做弥撒。顺着它走，能一直走到河边的芦苇荡。我一直没跟任何人说。」",
    "choices": [
      {
        "label": "「为什么现在告诉我？」",
        "effects": [
          {
            "op": "know",
            "who": "player",
            "fact": "K_SMUG"
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 4
          },
          {
            "op": "fact",
            "key": "story.he_route_told",
            "value": true
          }
        ],
        "result": "「因为我老了，走不动了。」他笑了笑，「路不该跟着人一起埋进土里。」"
      },
      {
        "label": "「应该让大家都知道。」",
        "effects": [
          {
            "op": "know",
            "who": "player",
            "fact": "K_SMUG"
          },
          {
            "op": "know",
            "who": "all",
            "fact": "K_SMUG"
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "respect": 3
          },
          {
            "op": "rel",
            "from": "all",
            "to": "player",
            "trust": 2
          },
          {
            "op": "fact",
            "key": "story.he_route_public",
            "value": true
          }
        ],
        "result": "何神父犹豫了一下，点点头。那天中午，他在长桌边把这条路讲给了所有人。有人眼睛亮了，有人开始算计。"
      },
      {
        "label": "「这条路，只有我们俩知道。」",
        "effects": [
          {
            "op": "know",
            "who": "player",
            "fact": "K_SMUG"
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": -3,
            "respect": -4
          },
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": 6
          },
          {
            "op": "fact",
            "key": "story.he_route_secret",
            "value": true
          }
        ],
        "result": "「秘密是有分量的。」他叹了口气，「你要背得动才好。」"
      }
    ]
  },
  {
    "id": "ns_han_seeds",
    "title": "种子",
    "trigger": {
