      },
      {
        "label": "「别一个人喝。」",
        "hide": true,
        "tags": [
          [
            "亲密",
            "#c05a9a"
          ]
        ],
        "when": {
          "settings.adult": true,
          "player.gender": "female",
          "a.rel.desire.gte": 50,
          "a.rel.trust.gte": 30
        },
        "effects": [
          {
            "op": "intimacy",
            "initiator": "a",
            "partner": "player",
            "consent": "willing",
            "motive": [
              "逃避",
              "慰藉"
            ]
          }
        ],
        "result": ""
      },
      {
        "label": "走开",
        "effects": [],
        "result": "你走开的时候，听见身后瓶子磕在水泥地上的声音。"
      }
    ]
  },
  {
    "id": "ns_zhao_bottle_2",
    "title": "酒",
    "trigger": {
      "on": "manual"
    },
    "cast": {
      "a": {}
    },
    "speaker": "a",
    "art": "dark",
    "text": "「我拿撬棍砸开闸，把人放上来了。」赵铁军说，「然后那个工头说要告我破坏生产。我就……」他没说完，把剩下的酒一口喝干了。\n\n「判了两年。人家说我运气好。死的那个，是阵线的人。」",
    "choices": [
      {
        "label": "「换了我，也会砸那个闸。」",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 8,
            "affection": 4
          },
          {
            "op": "memory",
            "who": "a",
            "about": "player",
