      "chance": 0.1,
      "once": true,
      "minDay": 4
    },
    "cast": {
      "a": {
        "who": "zhao"
      }
    },
    "speaker": "a",
    "art": "dark",
    "text": "油桶后面，赵铁军一个人坐在地上，手里攥着半瓶酒。他没开灯，只有发电机的指示灯照着他半张脸，那道疤一明一暗。\n\n「看什么？」他头也不抬，「没见过人喝酒？」",
    "choices": [
      {
        "label": "在他旁边坐下",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 5,
            "respect": 3
          },
          {
            "op": "need",
            "who": "player",
            "need": "stress",
            "add": -4
          },
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": -6
          }
        ],
        "result": "他把瓶子递给你，你喝了一口，辣得直咳。他笑了，第一次笑。\n\n「我坐过牢，你知道吧？」他看着手里的瓶子，「打死了一个工头。井下透水，他锁着闸不让人上来，说要先保设备。底下有十一个人。」",
        "next": "ns_zhao_bottle_2"
      },
      {
        "label": "「把酒给我。你明天还要去搬瓦砾。」",
        "check": {
          "skill": "persuade",
          "bonus": 0
        },
        "effects": [
          {
            "op": "item",
            "who": "a",
            "item": "alcohol",
            "qty": -1
          },
          {
            "op": "item",
            "who": "storage",
            "item": "alcohol",
            "qty": 1
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "respect": 5
          }
        ],
        "result": "他瞪了你半天，最后骂了一句，把瓶子往你怀里一塞。「拿走。拿走！」",
        "fail": {
          "effects": [
            {
              "op": "rel",
              "from": "a",
              "to": "player",
              "resentment": 8,
              "affection": -3
            },
            {
              "op": "bark",
