[
  {
    "id": "ns_lin_nightshift",
    "title": "夜班",
    "trigger": {
      "on": "hourly",
      "hours": [
        1,
        4
      ],
      "chance": 0.12,
      "once": true,
      "minDay": 3
    },
    "cast": {
      "a": {
        "who": "lin",
        "when": {
          "rel.trust.gte": 35
        }
      }
    },
    "speaker": "a",
    "art": "dark",
    "text": "凌晨，医务室的马灯还亮着。林秋坐在病床边，把药柜里剩下的药片一粒一粒倒在纱布上数，数完了又倒回去，再数一遍。\n\n她看见你，手停了一下。「……睡不着。我一闭眼，就听见走廊里有人喊护士。」",
    "choices": [
      {
        "label": "坐下来，陪她一起数",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 5,
            "affection": 4
          },
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": -10
          },
          {
            "op": "need",
            "who": "player",
            "need": "energy",
            "add": -5
          }
        ],
        "result": "你们数了三遍。四十一片，不多不少。林秋把药片收好，靠在墙上，第一次露出一点困意。"
      },
      {
        "label": "「你丈夫的事……我听说了。」",
        "when": {
          "a.rel.trust.gte": 55
        },
        "why": "她还没那么信你",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "trust": 6,
            "affection": 3
          },
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": -6
          },
          {
            "op": "memory",
            "who": "a",
            "about": "player",
            "kind": "story",
            "weight": 20,
            "text": "我跟{player.name}说了我丈夫的事。"
          },
          {
            "op": "fact",
            "key": "story.lin_husband_told",
            "value": true
          }
        ],
        "result": "「是半夜来的。」她说，「穿便衣，很客气，说只是去谈谈。他走的时候还穿着拖鞋。」\n\n她把纱布叠成很小的方块。「我后来才知道，那份名单上有个签名，是我们院长的。」"
      },
      {
        "label": "握住她的手",
        "hide": true,
        "tags": [
          [
            "亲密",
            "#c05a9a"
          ]
        ],
        "when": {
          "settings.adult": true,
          "player.gender": "male",
          "a.rel.desire.gte": 40,
          "a.rel.affection.gte": 40
        },
        "effects": [
          {
            "op": "intimacy",
            "initiator": "a",
            "partner": "player",
            "consent": "willing",
            "motive": [
              "慰藉"
            ]
          }
        ],
        "result": ""
      },
      {
        "label": "「去睡吧，明天还有病人。」",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "affection": -2
          },
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": 3
          }
        ],
        "result": "林秋点点头，却没有动。你走的时候，身后又传来药片落在纱布上的细碎声音。"
      }
    ]
  },
  {
    "id": "ns_ana_song",
    "title": "河那边的歌",
    "trigger": {
      "on": "hourly",
      "hours": [
        19,
        22
      ],
      "chance": 0.12,
      "once": true,
      "minDay": 2
    },
    "cast": {
      "a": {
        "who": "ana"
      },
      "b": {
        "who": "zhou",
        "optional": true
      }
    },
    "speaker": "a",
    "text": "炉子边上，阿娜忽然低声唱了起来。是她家乡的话，调子很长，像风从河面上刮过去。\n\n所有人都停下了手里的事。有人闭上眼睛，有人望着天花板上那盏晃动的灯泡。",
    "lines": [
      {
        "who": "b",
        "text": "唱的什么？听着不像我们的歌。"
      }
    ],
    "choices": [
      {
        "label": "跟着她轻轻地哼",
        "effects": [
          {
            "op": "need",
            "who": "everyone",
            "need": "stress",
            "add": -6
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "affection": 4,
            "trust": 2
          }
        ],
        "result": "你不会词，只能跟着调子。阿娜冲你笑了笑，唱完了最后一段。那天晚上，避难所里很少有人做噩梦。"
      },
      {
        "label": "「小点声。门外说不定有巡逻。」",
        "effects": [
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "affection": -3
          },
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": 4
          }
        ],
        "result": "歌声断了。阿娜耸耸肩，把烟别回耳朵上。「在这个国家，」她说，「连唱歌都要先看看门。」"
      },
      {
        "label": "递给她一支烟，请她再唱一首",
        "when": {
          "player.items.cigs.gte": 1
        },
        "why": "你没有烟",
        "tags": [
          [
            "香烟 -1",
            "#a8a080"
          ]
        ],
        "effects": [
          {
            "op": "item",
            "who": "player",
            "item": "cigs",
            "qty": -1
          },
          {
            "op": "item",
            "who": "a",
            "item": "cigs",
            "qty": 1
          },
          {
            "op": "rel",
            "from": "a",
            "to": "player",
            "affection": 6,
            "debt": 2
          },
          {
            "op": "need",
            "who": "a",
            "need": "stress",
            "add": -8
          }
        ],
        "result": "她接过烟，没点，夹在指间，又唱了一首。这一首很短，很轻。唱完她说：「这是我妈妈在河边洗衣服时唱的。」"
      },
      {
        "label": "等大家睡了，跟她去下层",
        "hide": true,
        "tags": [
          [
            "亲密",
            "#c05a9a"
          ]
        ],
        "when": {
          "settings.adult": true,
          "a.rel.desire.gte": 45,
          "a.rel.affection.gte": 40
        },
        "effects": [
          {
            "op": "intimacy",
            "initiator": "a",
            "partner": "player",
            "consent": "willing",
            "motive": [
              "爱慕",
              "好奇"
            ]
          }
        ],
        "result": ""
      }
    ]
  },
  {
    "id": "ns_zhao_bottle",
    "title": "酒",
    "trigger": {
