{
  "name": "new-shelter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/headless.ts",
    "validate:content": "tsx tools/validate.ts",
    "shot": "node tools/shot.mjs",
    "template:adult": "tsx tools/make-adult-template.ts",
    "test:routes": "tsx tools/routes.ts",
    "econ": "tsx tools/econ.ts",
    "export:content": "tsx tools/export-reference.ts",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:linux": "vite build && electron-builder --linux",
    "android:sync": "vite build && node tools/android-setup.mjs",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@types/node": "^26.6.5",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "main": "electron/main.cjs",
  "description": "避难所 · New Shelter",
  "author": "New Shelter",
  "build": {
    "appId": "io.github.muoushikoma.newshelter",
    "productName": "NewShelter",
    "copyright": "New Shelter",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "避难所",
      "artifactName": "NewShelter-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NewShelter-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "NewShelter-${version}.${ext}"
    }
  }
}
